# Copy to .env and fill in. .env is git-ignored.

# Warehouse target: leave unset for local DuckDB file; set to "cloud" for MotherDuck.
WC_ENV=

# MotherDuck (https://motherduck.com) — required only when WC_ENV=cloud
MOTHERDUCK_TOKEN=
MOTHERDUCK_DATABASE=wc2026

# football-data.org free API token (Phase 3 live ingestion)
FOOTBALL_DATA_API_TOKEN=
